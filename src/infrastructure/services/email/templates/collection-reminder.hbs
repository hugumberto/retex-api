{{#> layout title=(t "title")}}

  {{> eyebrow text=(t "eyebrow")}}

  <!-- Body -->
  <tr>
    <td style="padding:20px 40px 8px;">
      <p style="margin:0 0 12px;font-size:15px;color:#333333;">
        {{t "greeting"}}
      </p>
      <p style="margin:0 0 12px;font-size:15px;color:#333333;line-height:1.6;">
        {{#if collectionInterval}}{{t "introWithInterval"}}{{else}}{{t "intro"}}{{/if}}
      </p>
    </td>
  </tr>

  <!-- Details card -->
  <tr>
    <td style="padding:12px 40px 24px;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0"
        style="border:1px solid #e8e8e8;border-radius:8px;overflow:hidden;background-color:#F6F6F6;">

        <!-- Código -->
        <tr>
          <td style="padding:14px 20px;font-size:14px;color:#7F7F7F;width:45%;border-bottom:1px solid #f0f0f0;">
            {{t "codeLabel"}}</td>
          <td
            style="padding:14px 20px;font-size:14px;color:#013364;font-weight:700;letter-spacing:0.5px;border-bottom:1px solid #f0f0f0;">
            {{friendlyCode}}</td>
        </tr>

        <!-- Data -->
        <tr>
          <td style="padding:14px 20px;font-size:14px;color:#7F7F7F;width:45%;border-bottom:1px solid #f0f0f0;">
            {{t "dateLabel"}}</td>
          <td
            style="padding:14px 20px;font-size:14px;color:#013364;font-weight:700;border-bottom:1px solid #f0f0f0;">
            {{collectionDate}}</td>
        </tr>

        {{#if collectionInterval}}
        <!-- Intervalo -->
        <tr>
          <td style="padding:14px 20px;font-size:14px;color:#7F7F7F;border-bottom:1px solid #f0f0f0;">
            {{t "intervalLabel"}}</td>
          <td style="padding:14px 20px;font-size:14px;color:#013364;font-weight:500;border-bottom:1px solid #f0f0f0;">
            {{collectionInterval}}</td>
        </tr>
        {{/if}}

        {{#if address}}
        <!-- Endereço -->
        <tr>
          <td style="padding:14px 20px;font-size:14px;color:#7F7F7F;border-bottom:1px solid #f0f0f0;">
            {{t "addressLabel"}}</td>
          <td style="padding:14px 20px;font-size:14px;color:#013364;border-bottom:1px solid #f0f0f0;">
            {{address.street}}, {{address.number}}{{#if address.complement}} — {{address.complement}}{{/if}}
          </td>
        </tr>

        <!-- Cidade -->
        <tr>
          <td style="padding:14px 20px;font-size:14px;color:#7F7F7F;border-bottom:1px solid #f0f0f0;">
            {{t "cityLabel"}}</td>
          <td style="padding:14px 20px;font-size:14px;color:#013364;border-bottom:1px solid #f0f0f0;">
            {{address.city}}, {{address.countryDivision}}
          </td>
        </tr>

        <!-- Código-Postal -->
        <tr>
          <td style="padding:14px 20px;font-size:14px;color:#7F7F7F;">
            {{t "zipLabel"}}</td>
          <td style="padding:14px 20px;font-size:14px;color:#013364;">
            {{address.zipCode}}</td>
        </tr>
        {{/if}}

      </table>
    </td>
  </tr>

  <tr>
    <td style="padding:0 40px 32px;">
      <p style="margin:0 0 12px;font-size:13px;color:#7F7F7F;line-height:1.6;">
        {{t "prepNotice"}}
      </p>
      <p style="margin:0;font-size:15px;color:#333333;">
        {{t "signature"}}
      </p>
    </td>
  </tr>

{{/layout}}
